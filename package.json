{
  "name": "hibira-live-visitors",
  "private": true,
  "scripts": {
    "dev": "shopify app dev",
    "deploy": "shopify app deploy",
    "config:link": "shopify app config link",
    "shopify": "shopify",
    "lint": "eslint --ext .js,.mjs --cache --cache-location ./node_modules/.cache/eslint storefront tests waiting-room/storefront",
    "test": "vitest run tests/storefront/render.test.mjs tests/waiting-room tests/live-chat",
    "test:e2e": "vitest run tests/storefront/e2e.test.mjs",
    "build:storefront": "esbuild storefront/live-visitors.js --minify --target=es2017 --legal-comments=inline --outfile=extensions/live-visitors/assets/live-visitors.js",
    "build:waiting-room": "esbuild waiting-room/storefront/waiting-room.js --minify --target=es2017 --legal-comments=inline --outfile=waiting-room/extensions/waiting-room-embed/assets/waiting-room.js"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@shopify/cli": "^5.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "jsdom": "^26.1.0",
    "liquidjs": "^10.30.1",
    "prettier": "^3.6.2",
    "pusher": "^5.2.0",
    "vitest": "^5.0.3",
    "ws": "^8.22.1"
  },
  "workspaces": {
    "packages": [
      "extensions/*"
    ]
  },
  "version": "0.1.0",
  "description": "Shopify app: real live visitor counts and \"just bought\" popups, powered by Hibira",
  "homepage": "https://hibira.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/hibira-io/shopify.git"
  },
  "license": "MIT"
}
